<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp">

        <!-- Start -->
        <LinearLayout
            android:id="@+id/panel_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/x2x_green"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="48dp"
                android:gravity="center"
                android:text="@string/onboarding_subtitle"
                android:textColor="@color/x2x_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_wallet" />

            <Button
                android:id="@+id/btn_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/x2x_surface"
                android:text="@string/import_wallet" />
        </LinearLayout>

        <!-- Show seed -->
        <LinearLayout
            android:id="@+id/panel_show_seed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/seed_backup_title"
                android:textColor="@color/x2x_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/seed_backup_body"
                android:textColor="@color/x2x_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_seed_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_bg"
                android:fontFamily="monospace"
                android:lineSpacingExtra="8dp"
                android:padding="18dp"
                android:textColor="@color/x2x_on_surface"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_seed_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/seed_written_down" />

            <Button
                android:id="@+id/btn_seed_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/x2x_surface"
                android:text="@string/back" />
        </LinearLayout>

        <!-- Confirm seed -->
        <LinearLayout
            android:id="@+id/panel_confirm_seed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/seed_confirm_title"
                android:textColor="@color/x2x_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_confirm_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/x2x_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/et_confirm_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/seed_word_hint"
                android:inputType="text"
                android:textColor="@color/x2x_on_surface"
                android:textColorHint="@color/x2x_muted" />

            <Button
                android:id="@+id/btn_confirm_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/next" />

            <Button
                android:id="@+id/btn_confirm_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/x2x_surface"
                android:text="@string/back" />
        </LinearLayout>

        <!-- Import -->
        <LinearLayout
            android:id="@+id/panel_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_wallet"
                android:textColor="@color/x2x_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/import_seed_body"
                android:textColor="@color/x2x_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_import_seed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="top"
                android:hint="@string/seed_phrase_hint"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:textColor="@color/x2x_on_surface"
                android:textColorHint="@color/x2x_muted" />

            <Button
                android:id="@+id/btn_import_go"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/import_wallet" />

            <Button
                android:id="@+id/btn_import_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/x2x_surface"
                android:text="@string/back" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
